# Student services -> LOCAL database lt_student (Stages 2-3). Copy to tests/load/config/local/student.env (git-ignored).
# The password must equal LT_STUDENT_PASSWORD in tests/load/config/local/postgres.env. Host lt-postgres = the load-test container.
DATABASE_URL=postgresql+psycopg://lt_student:CHANGE_ME@lt-postgres:5432/lt_student
APP_ENV=dev
EMAIL_BACKEND=console
EMAIL_FROM=
CORS_ORIGINS=http://localhost:18080
SESSION_COOKIE_SECURE=false
FRONTEND_RESET_URL=http://localhost:18080/reset-password
