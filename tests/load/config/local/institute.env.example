# Institute services -> LOCAL database lt_institute (Stages 2-3). Copy to tests/load/config/local/institute.env (git-ignored).
# The password must equal LT_INSTITUTE_PASSWORD in tests/load/config/local/postgres.env. Host lt-postgres = the load-test container.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://lt_institute:CHANGE_ME@lt-postgres:5432/lt_institute
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:18081
FRONTEND_BASE_URL=http://localhost:18081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
STUDENT_SERVICE_URL=http://student-authentication-service:8000
STUDENT_TEST_SERVICE_URL=http://student-test-service:8001
STUDENT_RESULT_SERVICE_URL=http://student-result-service:8001
STUDENT_ATTEMPT_SERVICE_URL=http://student-attempt-service:8001
STUDENT_NOTIFICATION_SERVICE_URL=http://student-notification-service:8001
# Bulk-loaded stages pause the reference sync (Group B approval required before uncommenting):
# REFERENCE_SYNC_INTERVAL_SECONDS=0
