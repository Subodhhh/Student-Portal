# Local PostgreSQL of the load-test stack (lt-postgres) and its exporter. Copy to tests/load/config/local/postgres.env (git-ignored)
# and set NEW random passwords. Read once by postgres/initdb/10-roles-and-databases.sh when the lt-pgdata volume is first created.
POSTGRES_USER=lt_admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=postgres
LT_INSTITUTE_PASSWORD=CHANGE_ME
LT_STUDENT_PASSWORD=CHANGE_ME
# Monitoring role (member of pg_monitor; may connect only to the "postgres" database). Read by the init script and the exporter.
DATA_SOURCE_USER=lt_monitor
DATA_SOURCE_PASS=CHANGE_ME
