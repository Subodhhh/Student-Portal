# Student services -> Neon branch load_test_student (Stage 1). Copy to tests/load/config/neon/student.env (git-ignored).
# Paste the pooled connection string of load_test_student from the Neon console yourself; it is never shown in chat or logs.
# tests/load/lt.sh refuses to start until `lt.sh guard check neon` confirms the branch (config/targets.json).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-XXXX-pooler.c-14.us-east-1.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
APP_ENV=dev
EMAIL_BACKEND=console
EMAIL_FROM=
CORS_ORIGINS=http://localhost:18080
SESSION_COOKIE_SECURE=false
FRONTEND_RESET_URL=http://localhost:18080/reset-password
