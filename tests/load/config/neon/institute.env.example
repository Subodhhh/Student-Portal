# Institute services -> Neon branch load_test_institute (Stage 1). Copy to tests/load/config/neon/institute.env (git-ignored).
# Paste the pooled connection string of load_test_institute from the Neon console yourself; it is never shown in chat or logs.
# MIGRATION_DATABASE_URL is left empty: no migrations run in the load-test environment.
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@ep-XXXX-pooler.c-14.us-east-1.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:18081
FRONTEND_BASE_URL=http://localhost:18081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
# Student service URLs inside the load-test project network (keys come from tests/load/config/compose.env via the base file).
STUDENT_SERVICE_URL=http://student-authentication-service:8000
STUDENT_TEST_SERVICE_URL=http://student-test-service:8001
STUDENT_RESULT_SERVICE_URL=http://student-result-service:8001
STUDENT_ATTEMPT_SERVICE_URL=http://student-attempt-service:8001
STUDENT_NOTIFICATION_SERVICE_URL=http://student-notification-service:8001
# Stage 1 keeps the Institute -> Student reference sync ON (default 15 s). Setting 0 pauses it (Group B approval required).
# REFERENCE_SYNC_INTERVAL_SECONDS=15
