# Institute Identity and Access Service: staff identities, roles, sessions, MFA, password policy, audit log (single writer) and the introspection API used by every other service.
# Copy to .env (never commit it). Values below are placeholders.
APP_ENV=dev
SERVICE_NAME=institute-identity
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Separate, more privileged role used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
REDIS_URL=redis://redis:6379
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2
HIBP_ENABLED=false
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ACADEMICS_SERVICE_URL=http://institute-academics-service:8000
ACADEMICS_SERVICE_API_KEY=
# Keys that peer Institute services present on /internal/v1 (comma-separated; two during rotation; empty disables the internal API).
INTERNAL_API_KEYS=
ACADEMICS_SERVICE_URL=http://institute-academics-service:8000
ACADEMICS_SERVICE_API_KEY=
