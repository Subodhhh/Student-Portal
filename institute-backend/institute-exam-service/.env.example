# Institute Exam Management Service: exam plans, generation jobs, immutable exams, assignments, outbox delivery to the Student services, result corrections, worker.
# Copy to .env (never commit it). Values below are placeholders.
APP_ENV=dev
SERVICE_NAME=institute-exam
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Separate, more privileged role used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
IDENTITY_SERVICE_URL=http://institute-identity-service:8000
IDENTITY_SERVICE_API_KEY=
OPERATIONS_SERVICE_URL=http://institute-operations-service:8000
OPERATIONS_SERVICE_API_KEY=
STUDENT_SERVICE_URL=
STUDENT_SERVICE_API_KEY=
STUDENT_RESULT_SERVICE_URL=
STUDENT_RESULT_SERVICE_API_KEY=
STUDENT_ATTEMPT_SERVICE_URL=
STUDENT_ATTEMPT_SERVICE_API_KEY=
STUDENT_NOTIFICATION_SERVICE_URL=
STUDENT_NOTIFICATION_SERVICE_API_KEY=
STUDENT_TEST_SERVICE_URL=
STUDENT_TEST_SERVICE_API_KEY=
# Seconds between audit-spool deliveries to the identity service.
AUDIT_FORWARD_INTERVAL_SECONDS=5
PAPER_SERVICE_URL=http://institute-paper-service:8000
PAPER_SERVICE_API_KEY=
