# Institute Question and Paper Service: question bank, versioned papers, CSV/XLSX extraction, private file storage, paper sharing.
# Copy to .env (never commit it). Values below are placeholders.
APP_ENV=dev
SERVICE_NAME=institute-paper
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Separate, more privileged role used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
FILE_STORE_DIR=/var/institute/files
MAX_UPLOAD_BYTES=2097152
MAX_PAPER_QUESTIONS=500
# Recognition subject categories: JSON object mapping each subject_id (UUID) to CHEMISTRY, PHYSICS, MATHEMATICS or OTHER. Only the
# first three get subject-specific recognition (e.g. Chemistry's molar M); OTHER and unlisted subjects are recognised conservatively. Names are
# never parsed, so configure every science subject explicitly, e.g. RECOGNITION_SUBJECT_CATEGORIES={"<subject uuid>":"CHEMISTRY"}
RECOGNITION_SUBJECT_CATEGORIES={}
IDENTITY_SERVICE_URL=http://institute-identity-service:8000
IDENTITY_SERVICE_API_KEY=
# Seconds between audit-spool deliveries to the identity service.
AUDIT_FORWARD_INTERVAL_SECONDS=5
# Keys that peer Institute services present on /internal/v1 (the exam service shares papers through it).
INTERNAL_API_KEYS=

# Object storage for question pictures (docs/institute-portal/OPERATIONS.md, "Object storage"). local = private directory.
# s3: also OBJECT_STORE_BUCKET / OBJECT_STORE_REGION; credentials come from the AWS credential chain, never from this file.
OBJECT_STORE=local
OBJECT_STORE_DIR=./var/objects
OBJECT_STORE_BUCKET=
OBJECT_STORE_REGION=
OBJECT_STORE_ENDPOINT_URL=
OBJECT_STORE_PREFIX=
