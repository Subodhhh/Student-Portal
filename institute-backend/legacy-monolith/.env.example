# Copy to .env (never commit .env). Separate values per environment.
APP_ENV=dev                       # dev | qa | prod (qa/prod enforce secure settings at startup)
DATABASE_URL=postgresql+psycopg://RUNTIME_USER:PASSWORD@HOST/DATABASE?sslmode=require
# Migrations should use a separate, more privileged role:
MIGRATION_DATABASE_URL=postgresql+psycopg://MIGRATION_USER:PASSWORD@HOST/DATABASE?sslmode=require
REDIS_URL=redis://localhost:6379
CORS_ORIGINS=http://localhost:5174
FRONTEND_BASE_URL=http://localhost:5174
SESSION_COOKIE_SECURE=false       # must be true in qa/prod
SESSION_COOKIE_SAMESITE=strict    # strict | lax | none
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST_KIB=65536
ARGON2_PARALLELISM=2
HIBP_ENABLED=false                # optional k-anonymity breached-password lookup
# Email provider is configurable and not chosen yet: console (dev only) | smtp
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Student service integration (service-to-service key; never reuse across services)
STUDENT_SERVICE_URL=http://student-authentication-service:8000
STUDENT_SERVICE_API_KEY=
STUDENT_RESULT_SERVICE_URL=http://student-result-service:8001
STUDENT_RESULT_SERVICE_API_KEY=
STUDENT_ATTEMPT_SERVICE_URL=http://student-attempt-service:8001
STUDENT_ATTEMPT_SERVICE_API_KEY=
STUDENT_NOTIFICATION_SERVICE_URL=http://student-notification-service:8001
STUDENT_NOTIFICATION_SERVICE_API_KEY=
STUDENT_TEST_SERVICE_URL=http://student-test-service:8001
STUDENT_TEST_SERVICE_API_KEY=
# Inbound keys other services may use against this backend: name:key[,name:key]
SERVICE_API_KEYS=
# Private upload storage (never inside a web root; swap for object storage later)
FILE_STORE_DIR=./var/files

# Image papers are rejected unless an OCR backend is registered in code (none is bundled). If one is, every question must reach this confidence.
OCR_MIN_CONFIDENCE=0.98
