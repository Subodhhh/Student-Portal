# Institute Operations Service: staff notifications inbox, support, subscriptions, invoices, payments, adjustments, settings, dashboards.
# Copy to .env (never commit it). Values below are placeholders.
APP_ENV=dev
SERVICE_NAME=institute-operations
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Separate, more privileged role used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Keys that peer Institute services present on /internal/v1 (comma-separated; two during rotation; empty disables the internal API).
INTERNAL_API_KEYS=
IDENTITY_SERVICE_URL=http://institute-identity-service:8000
IDENTITY_SERVICE_API_KEY=
# Seconds between audit-spool deliveries to the identity service.
AUDIT_FORWARD_INTERVAL_SECONDS=5
# Readiness probes for the Service health page (the identity URL above is reused).
ORGANIZATION_SERVICE_URL=http://institute-organization-service:8000
ACADEMICS_SERVICE_URL=http://institute-academics-service:8000
ENROLLMENT_SERVICE_URL=http://institute-enrollment-service:8000
PAPER_SERVICE_URL=http://institute-paper-service:8000
EXAM_SERVICE_URL=http://institute-exam-service:8000
