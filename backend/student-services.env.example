# Shared settings for every Student service (docker compose reads backend/student-services.env; copy this file, never commit the copy).
# Neon branch subodh_dev. Use the postgresql+psycopg:// scheme.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/DATABASE?sslmode=require
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
SESSION_COOKIE_SECURE=false
APP_ENV=dev
# resend (needs RESEND_API_KEY + EMAIL_FROM) or console (dev only: links are written to the auth service log).
EMAIL_BACKEND=console
RESEND_API_KEY=
EMAIL_FROM=
FRONTEND_RESET_URL=http://localhost:8080/reset-password
