# Institute Question and Paper Service: question bank, versioned papers, CSV/XLSX extraction, private file storage, paper sharing.
# Copy to .env (never commit it). Values below are placeholders.
APP_ENV=dev
SERVICE_NAME=institute-paper
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Separate, more privileged role used only by `alembic upgrade head`.
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
FILE_STORE_DIR=/var/institute/files
MAX_UPLOAD_BYTES=2097152
MAX_PAPER_QUESTIONS=500
OCR_MIN_CONFIDENCE=0.98
IDENTITY_SERVICE_URL=http://institute-identity-service:8000
IDENTITY_SERVICE_API_KEY=
# Seconds between audit-spool deliveries to the identity service.
AUDIT_FORWARD_INTERVAL_SECONDS=5
# Keys that peer Institute services present on /internal/v1 (the exam service shares papers through it).
INTERNAL_API_KEYS=
