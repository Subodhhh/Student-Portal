DATABASE_URL=postgresql+psycopg://username:password@host/database
REDIS_URL=redis://student-auth-redis:6379

# Service key(s) allowed to call /internal/v1 (Institute backend). Empty disables it; list two during rotation.
INSTITUTE_SERVICE_API_KEYS=

# Student test service internal API (Global Test paper choice). Its key must be listed in the test service's INSTITUTE_SERVICE_API_KEYS.
STUDENT_TEST_SERVICE_URL=http://student-test-service:8001
STUDENT_TEST_SERVICE_API_KEY=
