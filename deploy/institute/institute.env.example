# Shared settings for every Institute service (docker compose reads deploy/institute/institute.env; copy this file, never commit the copy).
APP_ENV=dev
DATABASE_URL=postgresql+psycopg://USERNAME:PASSWORD@HOST/DATABASE?sslmode=require
# Used only when running `alembic upgrade head` (a more privileged role than the runtime one).
MIGRATION_DATABASE_URL=
CORS_ORIGINS=http://localhost:8081
FRONTEND_BASE_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=strict
# console (dev only: messages in the identity service log) or smtp. Resend over SMTP (docs/demo/CLOUDFLARE_DEMO.md):
# EMAIL_BACKEND=smtp, SMTP_HOST=smtp.resend.com, SMTP_PORT=587, SMTP_USERNAME=resend, SMTP_PASSWORD=<Resend API key>.
EMAIL_BACKEND=console
EMAIL_FROM=no-reply@example.invalid
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Student services (exam and enrollment services). URLs are the compose service names; keys must match each Student service's INSTITUTE_SERVICE_API_KEYS.
STUDENT_SERVICE_URL=http://student-authentication-service:8000
STUDENT_SERVICE_API_KEY=
STUDENT_TEST_SERVICE_URL=http://student-test-service:8001
STUDENT_TEST_SERVICE_API_KEY=
STUDENT_RESULT_SERVICE_URL=http://student-result-service:8001
STUDENT_RESULT_SERVICE_API_KEY=
STUDENT_ATTEMPT_SERVICE_URL=http://student-attempt-service:8001
STUDENT_ATTEMPT_SERVICE_API_KEY=
STUDENT_NOTIFICATION_SERVICE_URL=http://student-notification-service:8001
STUDENT_NOTIFICATION_SERVICE_API_KEY=
